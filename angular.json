{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "paan-party": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {"base": "dist", "browser": "client"},
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {"outputHashing": "all", "optimization": true},
            "development": {"optimization": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"host": "0.0.0.0", "port": 4173, "allowedHosts": ["terminal.local"], "proxyConfig": "proxy.conf.json"},
          "configurations": {"development": {"buildTarget": "paan-party:build:development"}},
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
