{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paan-party",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "dist/client", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "paan-party-db", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "drizzle" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
